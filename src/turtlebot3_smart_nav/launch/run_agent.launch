<?xml version="1.0"?>
<launch>
  <arg name="mode" default="train"/>
  <arg name="out"/>
  <arg name="policy" default=""/>
  <arg name="steps" default="10000"/>
  <arg name="episodes" default="20"/>
  <node if="$(eval arg('mode') == 'train')" pkg="turtlebot3_smart_nav" type="main_train.py" name="sac_train" output="screen"
        args="--backend ros --out $(arg out) --steps $(arg steps)"/>
  <node if="$(eval arg('mode') == 'test')" pkg="turtlebot3_smart_nav" type="evaluate_agent.py" name="sac_eval" output="screen"
        args="--backend ros --out $(arg out) --policy $(arg policy) --episodes $(arg episodes)"/>
</launch>
