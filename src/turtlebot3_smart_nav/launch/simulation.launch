<?xml version="1.0"?>
<launch>
  <arg name="gui" default="false"/>
  <param name="use_sim_time" value="true"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find turtlebot3_smart_nav)/worlds/navigation.world"/>
    <arg name="paused" value="false"/>
    <arg name="gui" value="$(arg gui)"/>
  </include>
  <param name="robot_description" command="$(find xacro)/xacro $(find turtlebot3_description)/urdf/turtlebot3_burger.urdf.xacro"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_turtlebot" output="screen"
        args="-urdf -model turtlebot3_burger -param robot_description -robot_namespace /turtlebot_lab -x -1.8 -y -1.8 -z 0.02"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <remap from="joint_states" to="/turtlebot_lab/joint_states"/>
  </node>
</launch>
